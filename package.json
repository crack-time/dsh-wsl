{
  "name": "@crack/dsh-wsl",
  "description": "WSL workspace plugin for DSH web: lets an operator register a workspace inside a WSL distro into DSH's native workspace registry (owned through its \\wsl.localhost UNC share), so it appears in the sidebar mixed with Windows workspaces. A \"＋ WSL 工作区\" button in the sidebar opens a browser to pick a distro, walk the Linux filesystem, create a folder, and register it.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "license": "MIT",
  "files": [
    "lib/client.js",
    "lib/client.js.map",
    "lib/index.js",
    "lib/types",
    "cordis.patch.yml"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.4",
    "@deepseek-ai/dsh-workspace": "0.1.2-alpha.4",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}